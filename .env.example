# Lekker Chat — local environment template
# Copy to .env — DATABASE_URL from Neon console (pooled connection string)

# =============================================================================
# MOBILE APP (required for Expo / iOS)
# =============================================================================

# Host:port only (no protocol). Uses http for localhost/LAN, https otherwise.
EXPO_PUBLIC_DOMAIN=localhost:5000

# Optional full override, e.g. https://your-app.replit.app:5000
# EXPO_PUBLIC_API_URL=

# =============================================================================
# LOCAL SERVER (npm run server:dev)
# =============================================================================

PORT=5000
NODE_ENV=development

# Required — Neon Lekker_Chat pooled URL (DSH project fragrant-fire-86534502)
# Prefer development for local work (quote the value — URL contains &):
#   neonctl connection-string development --project-id fragrant-fire-86534502 --org-id org-misty-band-95697604 --pooled
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Required — JWT signing (generate: openssl rand -base64 32)
SESSION_SECRET=

# =============================================================================
# LEKKER.NETWORK INTEGRATION
# =============================================================================

LEKKER_API_BASE_URL=https://lekker.network
LEKKER_NETWORK_API_URL=https://lekker.network/api/v1/lekkerpreneurs
LEKKER_NETWORK_API_KEY=

# HMAC secret for X-User-Assertion (Software tab SSO). Same value as Network
# MOBILE_USER_ASSERTION_SECRET. Must not equal LEKKER_NETWORK_API_KEY.
# Generate a new random value and set it only in the secret store. Leave this blank.
MOBILE_USER_ASSERTION_SECRET=

# Connect API (Marketplace master hub for Events/shop feed) — from lekker.network → Settings → Connect API
# Production Chat uses the same hub workspace as Lekker Marketplace.
LEKKER_WORKSPACE_ID=ebb114a2-c994-4d46-9274-bdd97ac23dde
LEKKER_TOKEN=

# Apple App Review — static login bypass (no WhatsApp OTP sent)
# Set on Replit production only; paste phone + code into App Store Connect review notes
APPLE_REVIEW_PHONE=+27821099999
APPLE_REVIEW_CODE=847291
APPLE_REVIEW_DISPLAY_NAME=Apple Reviewer

# =============================================================================
# TWILIO (WhatsApp OTP — primary auth)
# =============================================================================

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_FROM=
# TWILIO_CONTENT_SID=

# =============================================================================
# TRANSACTIONAL EMAIL (ecosystem — NOT Replit Gmail)
# Prefer SMTP2GO HTTP API for system mail; inbound.new is the fallback.
# =============================================================================

# SMTP2GO_LEKKER_NETWORK_API_KEY=
# SMTP2GO_API_KEY=
# INBOUND_API_KEY=
# SYSTEM_ZEPTOMAIL_API_KEY=
# SYSTEM_FROM_EMAIL=noreply@lekker.network
# SYSTEM_FROM_NAME=Lekker Chat
# SYSTEM_EMAIL_PROVIDER=auto
# SAFETY_REPORT_ALERT_TO=warren@digitalstudiohub.com,info@digitalstudiohub.com

# =============================================================================
# OBJECT STORAGE (GCS ADC on Cloud Run — NOT Replit sidecar)
# Path shape: /{bucket}/{prefix}
# =============================================================================

# OBJECT_STORAGE_BACKEND=gcs
# PRIVATE_OBJECT_DIR=/lekkernetworkbucket/lekker-chat/private
# PUBLIC_OBJECT_SEARCH_PATHS=/lekkernetworkbucket/lekker-chat/public

# =============================================================================
# AI (Chat-local OpenRouter mirror — migrate to Network Cledwyn later)
# =============================================================================

# AI_INTEGRATIONS_OPENROUTER_BASE_URL=
# AI_INTEGRATIONS_OPENROUTER_API_KEY=

# =============================================================================
# HUAWEI PUSH KIT (server). Leave unset until the Android app exists in
# AppGallery Connect. If either value is missing, the API keeps running:
# HMS tokens can be stored but are not delivered. FCM/APNs are unaffected.
# These are the Push Kit app id and app secret, not a team-level Connect
# API client. Do not commit values.
# =============================================================================

# HUAWEI_PUSH_APP_ID=
# HUAWEI_PUSH_APP_SECRET=

# Public app id for the AppGallery client (EAS env on the appgallery profile).
# Same id as HUAWEI_PUSH_APP_ID. Do not put the app secret in an EXPO_PUBLIC_ var.
# EXPO_PUBLIC_HUAWEI_APP_ID=
